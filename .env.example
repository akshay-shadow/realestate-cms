# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
# Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which site row (sites.slug) this deployment renders.
# One Supabase project can hold many client sites - deploy once per client
# with a different slug.
NEXT_PUBLIC_SITE_SLUG=demo

# Public URL of this deployment (used for SEO canonical, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- WhatsApp Cloud API (optional, for automatic server-side alerts) ----
# Meta for Developers -> WhatsApp -> API Setup.
# If left empty, only the "open WhatsApp after submit" option works.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recommended: an approved template so messages deliver outside the 24h window.
# Template body should have 5 variables: {{1}} name, {{2}} phone, {{3}} email,
# {{4}} interest, {{5}} message
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
